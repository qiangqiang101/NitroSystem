<UserControl

	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:local="clr-namespace:ForzaUI" 

    xmlns:System="clr-namespace:System;assembly=mscorlib"

	mc:Ignorable="d"

	x:Class="ForzaUI.HUDSpeedometerControl"

	x:Name="UserControl">

    

    <UserControl.Resources>																 

	    <ResourceDictionary>

            <!--

	        <ResourceDictionary.MergedDictionaries>

	            <ResourceDictionary Source="/Resources/Anthem/Shared_Hud.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            -->

            <System:Double x:Key="A_Double_Speedo_Width">300</System:Double>

            <System:Double x:Key="A_Double_Speedo_Analog_Height">300</System:Double>

            <System:Double x:Key="A_Double_Speedo_Digital_Height">60</System:Double>



            <Color x:Key="A_Color_Faded_HUDSpeedDigit">#4CFFFFFF</Color>



            <Color x:Key="A_Color_Nitrous_Fill">#FF2DB2FF</Color>

            <Color x:Key="A_Color_Nitrous_Background">#35FFFFFF</Color>

            <local:FZGeometry x:Key="A_FZGeometry_AnalogGaugeMesh" Data="M0,150L28.64745084,61.83221216 103.6474508,7.341522556 196.3525492,7.341522556 271.3525492,61.83221216 300,150 271.3525492,238.1677878 190,300 226.8566145,205.839599 245,150 226.8566145,94.16040103 179.3566145,59.64963095 120.6433855,59.64963095 73.14338553,94.16040103 55,150 73.14338553,205.839599 120,300 28.64745084,238.1677878z"/>



            <DropShadowEffect x:Key="A_DropShadowEffect_Speedo" Color="{StaticResource A_Color_DropShadow}" BlurRadius="5" ShadowDepth="2" />



            <Style x:Key="A_Style_FZMaterial_Speedometer_Speed_One" TargetType="local:FZMaterial">

            <Style.Triggers>

	    		    <DataTrigger Binding="{Binding SpeedLessOrEqualOne}" Value="True">

                        <Setter Property="Color" Value="{StaticResource A_Color_Faded_HUDSpeedDigit}" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="0">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_0.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="1">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_1.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="2">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_2.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="3">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_3.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="4">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_4.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="5">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_5.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="6">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_6.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="7">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_7.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="8">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_8.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitOne}" Value="9">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_9.png"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_Speedometer_Speed_Ten" TargetType="local:FZMaterial">

            <Style.Triggers>

	                <DataTrigger Binding="{Binding SpeedLessTen}" Value="True">

                        <Setter Property="Color" Value="{StaticResource A_Color_Faded_HUDSpeedDigit}" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="0">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_0.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="1">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_1.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="2">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_2.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="3">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_3.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="4">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_4.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="5">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_5.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="6">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_6.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="7">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_7.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="8">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_8.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitTen}" Value="9">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_9.png"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_Speedometer_Speed_Hundred" TargetType="local:FZMaterial">

            <Style.Triggers>

	                <DataTrigger Binding="{Binding SpeedLessHundred}" Value="True">

                        <Setter Property="Color" Value="{StaticResource A_Color_Faded_HUDSpeedDigit}" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="0">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_0.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="1">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_1.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="2">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_2.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="3">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_3.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="4">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_4.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="5">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_5.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="6">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_6.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="7">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_7.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="8">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_8.png"/>

                    </DataTrigger>

                    <DataTrigger Binding="{Binding SpeedDigitHundred}" Value="9">

                        <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_SpeedDigit_9.png"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>



             



            <Style x:Key="A_Style_FZMaterial_Lights" TargetType="local:FZMaterial">

                <Setter Property="Width" Value="64" />

                <Setter Property="Height" Value="64" />

            </Style>



            <Style x:Key="A_Style_FZMaterial_ABSLight" TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_Lights}">

                <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_ABSIcon_Off}" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsABSOn}" Value="True">

                         <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_ABSIcon_On}" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_TCRLight" TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_Lights}">

                <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_TCRIcon_Off}" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsTCROn}" Value="True">

                         <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_TCRIcon_On}" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_STMLight" TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_Lights}">

                <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_STMIcon_Off}" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsSTMOn}" Value="True">

                         <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_STMIcon_On}" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_ShiftLight" TargetType="{x:Type local:FZMaterial}">

                <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_ShiftLight_Off}" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsShiftLightOn}" Value="True">

                         <Setter Property="ImageSource" Value="{DynamicResource A_BitmapImage_ShiftLight_On}" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsShiftLightOn}" Value="True">

                         <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetAdditive}" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_SpeedUnits" TargetType="local:FZMaterial">

                <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Unit_MPH1.png" />

                <Setter Property="Color" Value="#77FFFFFF"/>

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsUsingMPH}" Value="True">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Unit_MPH1.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsUsingMPH}" Value="False">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Unit_KPH1.png" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_GearDisplay" TargetType="local:FZMaterial">

                <Style.Triggers>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="0">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_R.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="1">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_1.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="2">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_2.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="3">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_3.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="4">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_4.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="5">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_5.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="6">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_6.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="7">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_7.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="8">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_8.png" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding CurrentGear}" Value="9">

                         <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Digital_Gear_N.png" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>



            <Style x:Key="A_Style_FZMaterial_Needle" TargetType="local:FZMaterial">

                <Setter Property="ImageSource" Value="/ForzaUI;component/Textures/Anthem/HUD/Speedometer/HUD_Dial_Analogue_Needle.png" />

                <Setter Property="Width" Value="8"/>

                <Setter Property="Height" Value="84"/>

                <Setter Property="RenderTransformOrigin" Value="0.5,1.56"/>

            </Style>



            <Style x:Key="A_Style_FZMaterial_GaugeNumbers" TargetType="local:FZMaterial">

                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource A_FZBooleanToVisibilityConverter}}"/>

                <Setter Property="Width" Value="16" />

                <Setter Property="Height" Value="16" />

                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                <Setter Property="RenderTransform">

                    <Setter.Value>

                        <TranslateTransform X="{Binding XPos}" Y="{Binding YPos}"/>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- DIGITAL SPEEDOMETER -->



            <DataTemplate x:Key="A_DataTemplate_DigitalSpeedometer">

                <DataTemplate.Resources>

                    <ImageSource x:Key="A_BitmapImage_ABSIcon_Off">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_ABS_Off.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_TCRIcon_Off">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_TCR_Off.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_STMIcon_Off">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_STM_Off.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_ShiftLight_Off">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_ShiftLight_Digital_Off.png</ImageSource>



                    <ImageSource x:Key="A_BitmapImage_ABSIcon_On">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_ABS_On.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_TCRIcon_On">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_TCR_On.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_STMIcon_On">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_Assist_Digital_STM_On.png</ImageSource>

                    <ImageSource x:Key="A_BitmapImage_ShiftLight_On">/ForzaUI;component/Textures/Data_Bound/Anthem/HUD/HUD_Dial_ShiftLight_Digital_On.png</ImageSource>

                </DataTemplate.Resources>

                <Grid DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Vertical" Margin="-8,55,0,0">

                        <local:FZMaterial Style="{StaticResource A_Style_FZMaterial_SpeedUnits}" Width="64" Height="32" HorizontalAlignment="Center" Margin="0,0,0,-6"/>

                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="10,0,0,0">

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Vertical" Margin="2,0,-2,0">

                                <local:FZMaterial Width="32" Height="32" Style="{StaticResource A_Style_FZMaterial_ShiftLight}" HorizontalAlignment="Right" Margin="0,0,-2,-34"/> <!-- Shift Light -->

                                <local:FZMaterial Width="64" Height="128" Style="{StaticResource A_Style_FZMaterial_GearDisplay}" Margin="2,0,0,-2"/> <!-- Gear -->

                            </StackPanel>

                            <local:FZMaterial Width="60" Height="100" Style="{StaticResource A_Style_FZMaterial_Speedometer_Speed_Hundred}" Margin="-1,0,0,18"/> <!-- Hundred -->

                            <local:FZMaterial Width="60" Height="100" Style="{StaticResource A_Style_FZMaterial_Speedometer_Speed_Ten}" Margin="-11,0,0,18"/> <!-- Ten -->

                            <local:FZMaterial Width="60" Height="100" Style="{StaticResource A_Style_FZMaterial_Speedometer_Speed_One}" Margin="-11,0,0,18"/> <!-- One -->

                            <StackPanel VerticalAlignment="Bottom" Orientation="Vertical" Margin="-3,0,0,6">

                                <local:FZMaterial  Style="{StaticResource A_Style_FZMaterial_ABSLight}" Margin="0,0,0,-40"/>

                                <local:FZMaterial Style="{StaticResource A_Style_FZMaterial_TCRLight}" Margin="0,0,0,-40"/>

                                <local:FZMaterial Style="{StaticResource A_Style_FZMaterial_STMLight}" Margin="0,0,0,0"/>

                            </StackPanel>

                        </StackPanel>

                        <local:FZMaterial Height="{StaticResource A_Double_Speedo_Digital_Height}" Width="{StaticResource A_Double_Speedo_Width}" RenderTransformOrigin="0.5,0.5" Margin="1,-35,0,0"> <!-- Gauge -->
                        <local:FZMaterial.Preset>
                            <local:FZMaterialPresetDigitalGauge FillAmount="{Binding GaugeFillAmount}" RedLineAmount="{Binding GaugeRedlineAmount}" SmallDash="{Binding GaugeSmallDashAmount}" LargeDash="{Binding GaugeLargeDashAmount}" />
                        </local:FZMaterial.Preset>
                    </local:FZMaterial>
                    <!-- Authentic Fast & Furious NOS Digital Bar (4 Segments with Transparent Gaps) -->
                    <StackPanel Orientation="Horizontal" Margin="21,-22,0,0">
                        <Grid Margin="0,6,0,0">
                            <!-- 4 Sequential NOS Segments with Translucent Empty Background & Active White Tip Glow -->
                            <StackPanel Orientation="Horizontal" Width="245" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0">
                                <!-- Segment 1 (Leftmost) -->
                                <Grid DataContext="{Binding RPMGaugeNumbers[17]}" Width="59" Height="8" Margin="0,0,3,0">
                                    <Rectangle Width="59" Height="8" Fill="#35FFFFFF"/>
                                    <Grid Width="59" Height="8" HorizontalAlignment="Left" ClipToBounds="True" RenderTransformOrigin="0.0,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding XPos}"/>
                                        </Grid.RenderTransform>
                                        <Rectangle Width="59" Height="8" Fill="#FF2DB2FF"/>
                                        <Rectangle Width="59" Height="8" Opacity="{Binding YPos}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.0,0.5" EndPoint="1.0,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Grid>

                                <!-- Segment 2 -->
                                <Grid DataContext="{Binding RPMGaugeNumbers[18]}" Width="59" Height="8" Margin="0,0,3,0">
                                    <Rectangle Width="59" Height="8" Fill="#35FFFFFF"/>
                                    <Grid Width="59" Height="8" HorizontalAlignment="Left" ClipToBounds="True" RenderTransformOrigin="0.0,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding XPos}"/>
                                        </Grid.RenderTransform>
                                        <Rectangle Width="59" Height="8" Fill="#FF2DB2FF"/>
                                        <Rectangle Width="59" Height="8" Opacity="{Binding YPos}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.0,0.5" EndPoint="1.0,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Grid>

                                <!-- Segment 3 -->
                                <Grid DataContext="{Binding RPMGaugeNumbers[19]}" Width="59" Height="8" Margin="0,0,3,0">
                                    <Rectangle Width="59" Height="8" Fill="#35FFFFFF"/>
                                    <Grid Width="59" Height="8" HorizontalAlignment="Left" ClipToBounds="True" RenderTransformOrigin="0.0,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding XPos}"/>
                                        </Grid.RenderTransform>
                                        <Rectangle Width="59" Height="8" Fill="#FF2DB2FF"/>
                                        <Rectangle Width="59" Height="8" Opacity="{Binding YPos}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.0,0.5" EndPoint="1.0,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Grid>

                                <!-- Segment 4 (Rightmost) -->
                                <Grid DataContext="{Binding RPMGaugeNumbers[20]}" Width="59" Height="8">
                                    <Rectangle Width="59" Height="8" Fill="#35FFFFFF"/>
                                    <Grid Width="59" Height="8" HorizontalAlignment="Left" ClipToBounds="True" RenderTransformOrigin="0.0,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding XPos}"/>
                                        </Grid.RenderTransform>
                                        <Rectangle Width="59" Height="8" Fill="#FF2DB2FF"/>
                                        <Rectangle Width="59" Height="8" Opacity="{Binding YPos}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.0,0.5" EndPoint="1.0,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                    <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <!-- Outer Bracket -->
                            <local:FZMaterial ImageSource="/ForzaUI;component/Textures/Data_Bound/SpireHUD/HUD_Nos_Outline_Digital_Bar.png"
                                              Width="260"
                                              Height="20"
                                              Margin="2,-3,0,0"
                                              HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    </StackPanel>

                </Grid>

            </DataTemplate>



            <!-- ANALOG SPEEDOMETER -->



            <DataTemplate x:Key="A_DataTemplate_AnalogSpeedometer">

                <DataTemplate.Resources>

