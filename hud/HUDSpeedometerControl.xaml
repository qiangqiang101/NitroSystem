	<Grid x:Name="LayoutRoot" Height="450" Width="600" Margin="-150,-120,-100,-110">

	    <VisualStateManager.VisualStateGroups>

			<VisualStateGroup x:Name="VisualStateGroup">

				<VisualStateGroup.Transitions>

					<VisualTransition GeneratedDuration="0:0:0.0"/>

				</VisualStateGroup.Transitions>

				<VisualState x:Name="Hide">

					<Storyboard>

						<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot">

							<EasingDoubleKeyFrame KeyTime="0" Value="0"/>

						</DoubleAnimationUsingKeyFrames>

					</Storyboard>

				</VisualState>

				<VisualState x:Name="Show">

				    <Storyboard>

						<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot">

							<EasingDoubleKeyFrame KeyTime="0" Value="1"/>

						</DoubleAnimationUsingKeyFrames>

					</Storyboard>

                </VisualState>

			</VisualStateGroup>

        </VisualStateManager.VisualStateGroups>

        <Rectangle HorizontalAlignment="Center" Height="450" VerticalAlignment="Center" Width="600" Margin="0,30,0,0" Fill="{StaticResource A_Brush_MapShadowBackground}" Opacity="0"/>

        <!-- Nitro vignette: two full-screen radial gradients, far bigger than this control and shifted to the middle
             of the 1920x1080 scene. The plugin sets their opacity while the nitro burns (0 = invisible).
             A: the edge tint, opacity from RPMGaugeNumbers[18].YPos.
             B: a wider glow that reaches further in (the Intensity setting), opacity from RPMGaugeNumbers[19].YPos. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="2300" Height="1350"
                IsHitTestVisible="False" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Opacity="{Binding RPMGaugeNumbers[18].YPos}">
            <Border.RenderTransform>
                <TranslateTransform X="-693" Y="-362"/>
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#001E78FF" Offset="0"/>
                    <GradientStop Color="#001E78FF" Offset="0.55"/>
                    <GradientStop Color="#081E78FF" Offset="0.65"/>
                    <GradientStop Color="#241E78FF" Offset="0.75"/>
                    <GradientStop Color="#4A1E78FF" Offset="0.85"/>
                    <GradientStop Color="#781E8CFF" Offset="0.95"/>
                    <GradientStop Color="#A01E8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="2300" Height="1350"
                IsHitTestVisible="False" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Opacity="{Binding RPMGaugeNumbers[19].YPos}">
            <Border.RenderTransform>
                <TranslateTransform X="-693" Y="-362"/>
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#001E78FF" Offset="0"/>
                    <GradientStop Color="#001E78FF" Offset="0.3"/>
                    <GradientStop Color="#101E78FF" Offset="0.5"/>
                    <GradientStop Color="#2C1E78FF" Offset="0.7"/>
                    <GradientStop Color="#561E8CFF" Offset="0.85"/>
                    <GradientStop Color="#801E8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>








        <!-- SPEEDLINES-BEGIN elements -->
        <!-- Nitro speed lines (like NFS Unbound), see scripts/gen_speedlines.py: streaks flying outward in 6 tiers of different speed.
             They run all the time; the plugin sets the opacity of each tier container (RPMGaugeNumbers[15].XPos, RPMGaugeNumbers[15].YPos, RPMGaugeNumbers[14].XPos, RPMGaugeNumbers[14].YPos, RPMGaugeNumbers[13].XPos, RPMGaugeNumbers[13].YPos)
             from the nitro and the car speed (0 = invisible), crossfading neighbouring tiers. -->
        <Grid x:Name="NitroTier0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="2300" Height="1350" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
              Opacity="{Binding RPMGaugeNumbers[15].XPos}">
            <Grid.RenderTransform>
                <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform/><TranslateTransform X="-693" Y="-362"/></TransformGroup>
            </Grid.RenderTransform>
            <Rectangle x:Name="NitroSL0_0" Width="181.374" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5" Fill="{StaticResource NitroSpeedLine_Brush}">
